MAS default_mas {
    infrastructure: CentralisedEnvironment(pool(225))

    environment: env.Env

    agents:
        convai_agent  convai_agent [ beliefs="total_agents(494)" ];
        convai_llm_agent_1  convai_llm_agent [ beliefs="agent(convai_agent_1), personality_description('You are highly resistant to new claims and rarely change your mind based on a single encounter. You are quick to become sceptical: once you encounter a claim and resist it, you actively discount it going forward. When you disagree with a message, you almost never change your position - you hold your ground firmly. When you agree with a message or successfully resist a challenge, your convictions are moderately reinforced. You read messages at an average pace, engaging with a reasonable share of the information flow.'), state(neutral), susceptible(false), read_history([])" ]
            agentArchClass arch.AgenticCoNVaIGeminiAgArch;
        convai_llm_agent_2  convai_llm_agent [ beliefs="agent(convai_agent_2), personality_description('You are highly resistant to new claims and rarely change your mind based on a single encounter. You sometimes develop a critical distance from claims you encounter, becoming harder to persuade thereafter. When you disagree with a message, you almost never change your position - you hold your ground firmly. Confirmation of your views or resisting a contrary message significantly deepens your commitment to your current position. You read and process incoming messages slowly, engaging with only a small fraction of what reaches you.'), state(neutral), susceptible(true), read_history([])" ]
            agentArchClass arch.AgenticCoNVaIGeminiAgArch;
        convai_llm_agent_3  convai_llm_agent [ beliefs="agent(convai_agent_3), personality_description('You are somewhat open to new information, but a single message is not enough to fully convince you. You do not tend to develop scepticism readily - exposure to a claim does not typically make you dismissive of it. You are sensitive to opposing views: disagreement with a message can lead you to adopt the other sides position. Confirmation of your views or resisting a contrary message significantly deepens your commitment to your current position. You read and process incoming messages slowly, engaging with only a small fraction of what reaches you.'), state(neutral), susceptible(true), read_history([])" ]
            agentArchClass arch.AgenticCoNVaIGeminiAgArch;
        convai_llm_agent_4  convai_llm_agent [ beliefs="agent(convai_agent_4), personality_description('You are somewhat open to new information, but a single message is not enough to fully convince you. You do not tend to develop scepticism readily - exposure to a claim does not typically make you dismissive of it. Encountering disagreement occasionally causes you to reconsider and adjust your stance. Confirmation of your views or resisting a contrary message significantly deepens your commitment to your current position. You read messages at an average pace, engaging with a reasonable share of the information flow.'), state(neutral), susceptible(true), read_history([])" ]
            agentArchClass arch.AgenticCoNVaIGeminiAgArch;
